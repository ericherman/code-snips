#!/bin/bash

# guess if we have color
case "$TERM" in
	linux)			have_color=yes;;
	screen)			have_color=yes;;
	xterm)			have_color=yes;;
	xterm-color)		have_color=yes;;
	xterm-256color)		have_color=yes;;
	screen.xterm-color)	have_color=yes;;
	screen.xterm-256color)	have_color=yes;;
	ansi)			have_color=yes;;
	*)			have_color=no;;
esac

if [ "$have_color" == yes ]; then
	color_prompt=yes
else
	color_prompt=no
fi
unset have_color

COLOR_NONE="\[\e[0m\]"
GREEN="\[\e[32;1m\]"
BLUE="\[\e[34;1m\]"
DARK_GREEN="\[\e[0;32m\]"
RED="\[\e[31;1m\]"
DARK_RED="\[\e[0;31m\]"
BROWN="\[\e[0;33m\]"
YELLOW="\[\e[0;93m\]"

function prompt-color()
{
	if [ $1 -eq 0 ]; then
		echo "${GREEN}";
	else
		echo "${RED}";
	fi

	exit $1;
}

function optional-error-code()
{
	if [ $1 -eq 0 ]; then
		echo "";
	else
		echo "($1)";
	fi

	exit $1;
}

function optional-time()
{
	if [ -z "${PROMPT_TIME:-}" ] \
	|| [ "${PROMPT_TIME}" == "0" ] \
	|| [ "${PROMPT_TIME,,}" == "false" ] \
	|| [ "${PROMPT_TIME,,}" == "no" ] \
	; then
		exit $1;
	fi

	echo "$(date --utc +%H:%M:%SZ) "
	exit $1;
}

if [ $(id -u) -eq 0 ]; then
	PROMPT_SYMBOL="#"
else
	PROMPT_SYMBOL="\$"
fi

if [ "$color_prompt" == yes ]; then
	if [ $(id -u) -eq 0 ]; then
		USER_COLOR=$DARK_RED
	elif [[ "$USER" =~ "admin" ]]; then
		USER_COLOR=$YELLOW
	else
		USER_COLOR=$DARK_GREEN
	fi

	export PROMPT_COMMAND='PS1="\
${COLOR_NONE}$(optional-time $?)\
${USER_COLOR}\u${COLOR_NONE}\
@\h\
:${BLUE}\w${COLOR_NONE}\
$(prompt-color $?)$(optional-error-code $?)${PROMPT_SYMBOL}${COLOR_NONE}\
 "'
else
	export PROMPT_COMMAND='PS1="\
$(optional-time $?)\
\u@\h\
:\w\
$(optional-error-code $?)${PROMPT_SYMBOL}\
 "'
fi
unset color_prompt
